# Feishin (web rebuild) — environment template.
# Copy to .env and fill in your own values; .env is git-ignored and never leaves the server.

# SQLite database for the Library Agent (findings, health snapshots, sound profiles)
DATABASE_URL=file:./db/custom.db

# Optional: Fanart.tv personal API key for artist photos (https://fanart.tv/get-an-api-key/)
# Can also be set at runtime via Agent → Settings.
# FANARTTV_API_KEY=

# Jellyfin server (server-side only; the browser never sees these).
# If unset, the app starts on the "Add server" login screen instead.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=
JELLYFIN_API_KEY=
