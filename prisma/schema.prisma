// Library Agent — persistent state for the autonomous media-library manager
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per job execution (health check / library scan)
model AgentRun {
  id         String    @id @default(cuid())
  jobType    String // "health" | "scan"
  status     String    @default("running") // running | success | partial | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  processed  Int       @default(0) // items examined
  enriched   Int       @default(0) // gaps filled with data
  missing    Int       @default(0) // gaps confirmed unresolvable
  error      String?
  log        String? // newline-separated activity log (trimmed)
}

// One scraped datum about one library item, keyed by (itemId, kind).
// kind: "artwork" | "bio" | "metadata" | "lyrics"
// status: "pending" (gap noticed, not yet looked up) | "found" | "missing" | "applied" | "error"
// serverStatus: write-back state towards Jellyfin — none | synced | failed
model AgentFinding {
  id             String    @id @default(cuid())
  itemId         String
  itemType       String // album | artist | song
  itemName       String    @default("")
  itemSubtitle   String    @default("") // artist name (albums) / album name (songs)
  kind           String
  source         String    @default("") // deezer | itunes | coverart | musicbrainz | wikipedia | lrclib
  status         String    @default("found")
  payload        String    @default("{}") // JSON blob with the scraped data
  summary        String    @default("") // human-readable one-liner for the dashboard
  serverStatus   String    @default("none") // none | synced | failed (Jellyfin write-back)
  serverError    String?
  serverSyncedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([itemId, kind])
  @@index([kind, status])
  @@index([status])
  @@index([serverStatus])
}

// Point-in-time system health report
model HealthSnapshot {
  id            DateTime @id @default(now())
  overall       String // healthy | degraded | critical
  score         Int      @default(0) // 0-100
  checks        String   @default("[]") // JSON [{name,status,latencyMs,detail}]
  serverName    String   @default("")
  serverVersion String   @default("")
  serverLatency Int      @default(0)
  albumCount    Int      @default(0)
  songCount     Int      @default(0)
  mediaReadable Float    @default(0) // 0..1 fraction of sampled files readable
  cacheMb       Float    @default(0)
  memoryMb      Float    @default(0)
  internetOk    Boolean  @default(false)
}

// Listening digest — per-artist play counts captured in daily batches.
// All rows of one run share the exact same `takenAt` so batches group cleanly.
// The scheduler replaces today's batch, so each day holds a single authoritative
// snapshot; the monthly digest diffs the newest batch against the oldest batch
// inside the current month (fallback: trailing 30 days).
model PlaySnapshot {
  id         String   @id @default(cuid())
  takenAt    DateTime // batch timestamp — identical for every row of one run
  level      String   @default("artist") // artist (aggregated from played tracks)
  artistKey  String // normalized artist name (diacritic-free) — stable join key
  artistName String
  artistId   String   @default("") // Jellyfin artist item id (empty when unknown)
  playCount  Int      @default(0) // summed plays across the artist's tracks
  trackCount Int      @default(0) // distinct played tracks for this artist

  @@index([takenAt])
  @@index([artistKey])
  @@index([takenAt, artistKey])
}

// Singleton configuration row
model AgentConfig {
  id                String   @id @default("singleton")
  enabled           Boolean  @default(true)
  scanIntervalMin   Int      @default(45)
  healthIntervalMin Int      @default(5)
  batchSize         Int      @default(16)
  writeBack         String   @default("manual") // off | manual | auto — push scraped data into Jellyfin
  sources           String   @default("{}") // JSON {musicbrainz,deezer,itunes,coverart,wikipedia,lrclib,fanart}
  fanartApiKey      String? // Fanart.tv personal API key (artist photos) — or FANARTTV_API_KEY env
  lastStage         String   @default("albums") // albums | artists — alternates between runs
  auditCursor       Int      @default(0) // rolling audit window position (songs are audited in chunks across runs)
  updatedAt         DateTime @updatedAt
}
